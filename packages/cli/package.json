{
  "name": "@zurchin/cli",
  "version": "2.7.0",
  "description": "Pidgeon from a terminal. Email for founders, teams and agents: make an inbox on @pidgeon.email or your domain, send, and wait for the reply.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zurchin/pidgeon-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://zurchin.com",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "team-inbox",
    "unified-inbox",
    "cli",
    "zurchin"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zurchin": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@zurchin/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5"
  }
}
