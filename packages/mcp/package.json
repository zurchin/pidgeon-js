{
  "name": "@pidgeon-ai/mcp",
  "version": "1.16.0",
  "description": "Pidgeon's MCP server. Email for founders, teams and agents: give your AI agents inboxes beside your team's, on @pidgeon.email or your own domains.",
  "license": "Apache-2.0",
  "type": "module",
  "mcpName": "ai.pidgeon/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgeon-ai/pidgeon-js.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://pidgeon.ai",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "team-inbox",
    "unified-inbox",
    "model-context-protocol",
    "pidgeon"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pidgeon-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pidgeon-ai/sdk": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5"
  }
}
