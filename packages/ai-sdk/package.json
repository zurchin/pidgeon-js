{
  "name": "@zurchin/ai-sdk",
  "version": "1.2.1",
  "description": "Zurchin as Vercel AI SDK tools. Email for founders, teams and agents: send, wait for the reply and answer, on @zurchin.email or your domain. The same tools as Zurchin's MCP server.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zurchin/pidgeon-js.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://zurchin.com",
  "keywords": [
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "mcp",
    "team-inbox",
    "unified-inbox",
    "vercel-ai-sdk",
    "ai-sdk",
    "tools",
    "zurchin"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "ai": "^7"
  },
  "dependencies": {
    "@zurchin/mcp": "workspace:^",
    "@zurchin/sdk": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ai": "^7.0.173",
    "typescript": "^5"
  }
}
