{
  "name": "@zurchin/n8n-nodes-zurchin",
  "version": "1.1.1",
  "description": "Zurchin in n8n. Email for founders, teams and agents: send, reply, read and wait for mail, and a trigger for the mail that arrives.",
  "keywords": [
    "n8n-community-node-package",
    "email",
    "inbox",
    "ai-agents",
    "agent-email",
    "team-inbox",
    "unified-inbox",
    "n8n",
    "zurchin",
    "webhook"
  ],
  "license": "MIT",
  "author": {
    "name": "Zurchin",
    "email": "support@pidgeon.ai"
  },
  "homepage": "https://zurchin.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zurchin/pidgeon-js.git",
    "directory": "packages/n8n"
  },
  "bugs": {
    "url": "https://github.com/zurchin/pidgeon-js/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "dev": "n8n-node dev"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PidgeonApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pidgeon/Pidgeon.node.js",
      "dist/nodes/PidgeonTrigger/PidgeonTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.3",
    "eslint": "9.39.4",
    "n8n-workflow": "2.47.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
